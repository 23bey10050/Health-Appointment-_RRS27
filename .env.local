# ---------------------------------------------------------------------------
# Health Appointment - local environment template
#
# This file IS committed on purpose. It contains no real secrets, only the list
# of variables the app needs plus a note on where each value comes from.
#
# To run the project:
#   1. cp .env.local .env
#   2. Fill in the values below that are marked REQUIRED.
#   3. npm install && npm run db:up && npm run dev
#
# Anything marked OPTIONAL can stay empty. The app detects a missing key and
# falls back to a local stand-in, so you can build and demo the whole thing
# without signing up for a single service. See docs/setup.txt for the click-by-
# click account guide.
# ---------------------------------------------------------------------------

# --- Core server ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# `::` accepts both IPv6 and IPv4 on one socket. Using 0.0.0.0 here would add roughly 200ms to
# every local request, because browsers try ::1 before 127.0.0.1 and have to wait for the refusal.
HOST=::
LOG_LEVEL=debug

# Comma separated list of sites allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173

# How long we let in-flight requests finish before forcing the process to quit.
SHUTDOWN_TIMEOUT_MS=10000

# --- Database (REQUIRED) -------------------------------------------------
# `npm run db:up` starts a Postgres 16 container that matches this exact URL,
# so you can leave it as-is for local work.
# For a free hosted database, create a project at https://neon.com (no card
# needed) and paste its pooled connection string here instead.
DATABASE_URL=postgresql://health:health@localhost:5432/health_appointment

# Neon closes idle connections on its side. Keeping our pool small and our idle
# timeout short avoids handing out sockets the server has already hung up on.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=20000
DATABASE_CONNECT_TIMEOUT_MS=8000

# --- Auth (REQUIRED) ------------------------------------------------------
# Signs access tokens. This placeholder is long enough to pass validation so
# local development works immediately, but the server refuses to start with
# NODE_ENV=production while this exact value is still in place. Generate a
# real one before deploying anywhere real, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-before-deploying-anywhere-real

# How long an access token is trusted before the browser must use its refresh
# token to get a new one. Kept short on purpose - if one ever leaks, this is
# how long the damage window is.
JWT_ACCESS_TTL_SECONDS=900

# How long a refresh token lasts before its owner must log in again by hand.
JWT_REFRESH_TTL_DAYS=30
