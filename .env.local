# ---------------------------------------------------------------------------
# Health Appointment - local environment template
#
# This file IS committed on purpose. It contains no real secrets, only the list
# of variables the app needs plus a note on where each value comes from.
#
# To run the project:
#   1. cp .env.local .env
#   2. Fill in the values below that are marked REQUIRED.
#   3. npm install && npm run db:up && npm run dev
#   4. In a second terminal: npm run dev:web - the API and the browser app run as two
#      separate processes, the same way they will in production (Render and Cloudflare
#      Pages are two separate deploys too).
#
# Anything marked OPTIONAL can stay empty. The app detects a missing key and
# falls back to a local stand-in, so you can build and demo the whole thing
# without signing up for a single service. See docs/setup.txt for the click-by-
# click account guide.
# ---------------------------------------------------------------------------

# --- Core server ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# `::` accepts both IPv6 and IPv4 on one socket. Using 0.0.0.0 here would add roughly 200ms to
# every local request, because browsers try ::1 before 127.0.0.1 and have to wait for the refusal.
HOST=::
LOG_LEVEL=debug

# Comma separated list of sites allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173

# How long we let in-flight requests finish before forcing the process to quit.
SHUTDOWN_TIMEOUT_MS=10000

# --- Browser app (apps/web) ------------------------------------------------
# The only variable Vite actually hands to browser code - anything not prefixed VITE_ in this
# whole file stays server-side only, by Vite's own design, which is what makes sharing one .env
# between the API and the browser app safe rather than a way to leak JWT_ACCESS_SECRET into a
# bundle. Left as-is, this already matches the API's own default local port.
VITE_API_URL=http://localhost:4000

# --- Database (REQUIRED) -------------------------------------------------
# `npm run db:up` starts a Postgres 16 container that matches this exact URL,
# so you can leave it as-is for local work.
# For a free hosted database, create a project at https://neon.com (no card
# needed) and paste its pooled connection string here instead.
DATABASE_URL=postgresql://health:health@localhost:5432/health_appointment

# Neon closes idle connections on its side. Keeping our pool small and our idle
# timeout short avoids handing out sockets the server has already hung up on.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=20000
DATABASE_CONNECT_TIMEOUT_MS=8000

# --- Auth (REQUIRED) ------------------------------------------------------
# Signs access tokens. This placeholder is long enough to pass validation so
# local development works immediately, but the server refuses to start with
# NODE_ENV=production while this exact value is still in place. Generate a
# real one before deploying anywhere real, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-secret-change-before-deploying-anywhere-real

# How long an access token is trusted before the browser must use its refresh
# token to get a new one. Kept short on purpose - if one ever leaks, this is
# how long the damage window is.
JWT_ACCESS_TTL_SECONDS=900

# How long a refresh token lasts before its owner must log in again by hand.
JWT_REFRESH_TTL_DAYS=30

# --- Email (OPTIONAL) ------------------------------------------------------
# Leave all three of these blank and the app still runs completely normally -
# booking confirmations, cancellations and reminders get printed to this
# process's own log instead of actually being sent. That is the real, fully
# supported way to build and demo this project without signing up for
# anything. Fill them in once you have a free account at https://brevo.com
# (300 emails/day, forever, no card) and want real email to go out.
#
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Health Appointment Clinic

# --- AI Summaries (OPTIONAL) ------------------------------------------------
# Leave both of these blank and the app still runs completely normally - a booked appointment
# gets a plain, honest fallback message instead of an AI-written triage brief, and a submitted
# doctor's note gets the same for its patient-facing summary. That is a real, fully supported way
# to build and demo this project without signing up for anything.
#
# Fill in GROQ_API_KEY alone, GEMINI_API_KEY alone, or both, and the app calls whichever is
# configured - Groq first, with one retry, then Gemini as a fallback if Groq is unavailable.
# Both have free tiers with no credit card required.
#   Groq:   https://console.groq.com          (Llama 3.3 70B, generous daily free limit)
#   Gemini: https://aistudio.google.com/apikey (Gemini 3.1 Flash-Lite, generous daily free limit)
#
# GROQ_API_KEY=
# GEMINI_API_KEY=

# --- Google Calendar Sync (OPTIONAL) ---------------------------------------
# Leave all four of these blank and the app still runs completely normally -
# booking and cancelling an appointment simply creates no calendar event for
# anyone, which is a real, fully supported way to build and demo this
# project. All four are required together once you turn this on; there is no
# useful state with only some of them set.
#
# 1. https://console.cloud.google.com -> new project -> enable the
#    "Google Calendar API". No billing needs to be enabled for this.
# 2. OAuth consent screen -> External -> Testing mode -> add yourself as a
#    test user -> scope https://www.googleapis.com/auth/calendar.events
# 3. Credentials -> Create OAuth client ID -> Web application -> add
#    http://localhost:4000/auth/google/callback as an authorized redirect URI
# 4. GOOGLE_TOKEN_ENCRYPTION_KEY encrypts stored tokens at rest and must
#    decode to exactly 32 bytes - generate one with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=
