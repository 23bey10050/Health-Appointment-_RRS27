{
  "name": "@health/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API and background scheduler for the clinic platform.",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@health/contracts": "*",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
