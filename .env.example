# Local development defaults. For deployment see deploy/README.md.
#
# Deploying: set APP_BASE_URL and GOOGLE_REDIRECT_URI to your real https domain
# (Google OAuth rejects a localhost redirect URI once the app is reachable from
# anywhere else), and point DATABASE_URL at your managed Postgres.

# Core
DATABASE_URL=postgresql+asyncpg://clinic:clinic@postgres:5432/clinic
# Managed Postgres (Neon). Two things matter:
#   ?ssl=require  -- not ?sslmode=require. asyncpg rejects the libpq spelling.
#   direct host   -- not the "-pooler" endpoint. Booking uses
#                    pg_advisory_xact_lock, which PgBouncer's transaction mode
#                    does not preserve.
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx.neon.tech/clinic?ssl=require
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-random-64-char-secret
CALENDAR_TOKEN_ENCRYPTION_KEY=          # Fernet key -- generate with Fernet.generate_key()
APP_BASE_URL=http://localhost:5173      # your frontend origin; replace when deployed
# Extra browser origins allowed by CORS, comma-separated. APP_BASE_URL is always
# allowed; this is for apex+www or preview deploys. Exact matches only --
# allow_credentials=True forbids a wildcard.
CORS_ALLOWED_ORIGINS=

# Connection pool. Defaults suit a managed free tier; raise for a bigger instance.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
CLINIC_NAME="City Care Clinic"
DEFAULT_TIMEZONE=Asia/Kolkata
ENVIRONMENT=development                 # development | production

# LLM providers. One key is enough to run; two or more gives you failover.
# Model catalogs move fast -- on model_not_found, check the provider's model list
# before assuming the key is bad.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASON_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_REASON_MODEL=gemini-3.5-flash
CEREBRAS_API_KEY=
CEREBRAS_FAST_MODEL=gpt-oss-120b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_FAST_MODEL=qwen3:8b
OLLAMA_REASON_MODEL=qwen3:14b
LLM_REDACT_PHI=true

# Speech: nothing to configure. Recognition and synthesis are both the browser's
# Web Speech API, entirely client-side. Audio is therefore transcribed by the
# browser vendor's service (Google, in Chrome) -- the consent screen says so.

# RAG
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2  # bge-reranker-v2-m3 isn't in fastembed's catalog; see config.py
RERANK_SCORE_GAP_THRESHOLD=0.05

# Email
EMAIL_PROVIDER=smtp                     # brevo | smtp
BREVO_API_KEY=
SMTP_HOST=mailpit                       # docker-compose's local SMTP catcher; see README
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="City Care Clinic <noreply@example.com>"

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback

# Voice / safety
VOICE_SESSION_MAX_MIN=15
SLOT_HOLD_TTL_SECONDS=300
AUDIO_RETENTION_DAYS=7
EMERGENCY_NUMBERS=108,112
MENTAL_HEALTH_HELPLINE=14416
ONCALL_ALERT_EMAILS=

# Shared secret for the scheduled-job endpoints (/api/v1/jobs/*), used when there
# is no Celery worker and an external cron drives the jobs over HTTP. Unset means
# those endpoints refuse every caller, which is right for local dev where celery
# beat is already running.
JOBS_SECRET=

# Postgres (used by docker-compose for the local dev/test database only)
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
